{
  "name": "neuroinfoapi-client",
  "version": "2.6.1",
  "description": "A client for interacting with the NeuroInfoAPI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "powershell -NoProfile -Command \"if (Test-Path dist) { Remove-Item dist -Recurse -Force }\"",
    "test": "bun test tests",
    "publishPackage": "powershell -ExecutionPolicy Bypass -File .\\publishAsk.ps1",
    "deprecatePackage": "powershell -ExecutionPolicy Bypass -File .\\deprecateAsk.ps1"
  },
  "keywords": [],
  "author": "Appstun",
  "license": "MIT",
  "homepage": "https://neuro.appstun.net/api/docs",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
